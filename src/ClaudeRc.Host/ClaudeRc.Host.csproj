<Project Sdk="Microsoft.NET.Sdk">
  <!-- ClaudeRcHost.exe: headless background process that owns every session (SPEC 2, 13). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ClaudeRcHost</AssemblyName>
    <AssemblyTitle>claude-rc-windows host</AssemblyTitle>
    <RootNamespace>ClaudeRc.Host</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClaudeRc.Core\ClaudeRc.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeRc.Host.Tests" />
  </ItemGroup>
</Project>
