<Project Sdk="Microsoft.NET.Sdk">
  <!-- ClaudeRc.exe: tray icon and main window; a client of the host's pipe (SPEC 2, 3, 13). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>ClaudeRc</AssemblyName>
    <RootNamespace>ClaudeRc.Tray</RootNamespace>
    <ApplicationIcon>Assets\tray.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClaudeRc.Core\ClaudeRc.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\tray.ico" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeRc.Tray.Tests" />
    <!-- WPF projects leave System.IO out of the implicit usings (Path clashes with Shapes.Path). -->
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
