<Window x:Class="ClaudeRc.Tray.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="{Binding Title}" Width="820" Height="480" WindowStartupLocation="CenterOwner" Icon="/Assets/tray.ico">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10,6" BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,2" Command="{Binding RefreshCommand}" />
        <TextBlock Text="{Binding Path}" VerticalAlignment="Center" Foreground="{StaticResource MutedText}"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <TextBox x:Name="LogText" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
             FontSize="12" BorderThickness="0" Padding="6" VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto" TextChanged="LogText_TextChanged" />
  </DockPanel>
</Window>
