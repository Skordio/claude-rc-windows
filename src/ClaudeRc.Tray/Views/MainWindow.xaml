<Window x:Class="ClaudeRc.Tray.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeRc.Tray.ViewModels"
        x:ClassModifier="internal"
        Title="claude-rc-windows" Width="860" Height="540" MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterScreen" Icon="/Assets/tray.ico">
  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource ToolButton}" Content="+ Add folder" Command="{Binding AddFolderCommand}"
                IsEnabled="{Binding IsHostConnected}" AutomationProperties.Name="Add folder" />
        <Button Style="{StaticResource ToolButton}" Content="Settings" Command="{Binding SettingsCommand}" />
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="10,5" BorderBrush="{StaticResource RowBorder}" BorderThickness="0,1,0,0"
            Background="#FFF6F7F8">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource DotRed}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsHostConnected}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource DotGreen}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding HostStatusText}" VerticalAlignment="Center" />
          <Button Content="Start host" Command="{Binding StartHostCommand}" Margin="8,0,0,0" Padding="8,1"
                  Visibility="{Binding ShowStartHost, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="  |  " Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StartModeText}" VerticalAlignment="Center" />
          <Button Content="Re-enter password" Command="{Binding ReenterPasswordCommand}" Margin="8,0,0,0" Padding="8,1"
                  ToolTip="Task Scheduler could not start the host because your Windows password changed."
                  Visibility="{Binding ShowReenterPassword, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="  |  " Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding ClaudeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding ClaudeText}" />
      </DockPanel>
    </Border>

    <Grid>
      <TextBlock Text="No folders yet. Use + Add folder to pick one; claude rc then runs there now and after every restart."
                 TextWrapping="Wrap" Margin="24" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"
                 VerticalAlignment="Center" TextAlignment="Center"
                 Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding HostDownHint}" TextWrapping="Wrap" Margin="24" Foreground="{StaticResource MutedText}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="520" />

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:FolderRowViewModel}">
              <Border BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0,1" Padding="12,8">
                <!-- A toast click highlights its row for a few seconds (SPEC 3.5). -->
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHighlight}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Status dot -->
                  <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,4,10,0" VerticalAlignment="Top"
                           ToolTip="{Binding StatusText}">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{StaticResource DotGrey}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding StatusColor}" Value="{x:Static vm:StatusColor.Green}">
                            <Setter Property="Fill" Value="{StaticResource DotGreen}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding StatusColor}" Value="{x:Static vm:StatusColor.Yellow}">
                            <Setter Property="Fill" Value="{StaticResource DotYellow}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding StatusColor}" Value="{x:Static vm:StatusColor.Red}">
                            <Setter Property="Fill" Value="{StaticResource DotRed}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding StatusColor}" Value="{x:Static vm:StatusColor.Blue}">
                            <Setter Property="Fill" Value="{StaticResource DotBlue}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>

                  <!-- Name, status, path, prompt, error, last lines -->
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <WrapPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,0">
                        <!-- An unsaved row (SPEC 7: external claude rc in a folder not in the list) is in italics. -->
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsUnsaved}" Value="True">
                                <Setter Property="FontStyle" Value="Italic" />
                                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Border Margin="0,0,10,0" Padding="5,0" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center"
                              BorderBrush="{StaticResource DotBlue}"
                              Visibility="{Binding IsUnsaved, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding UnsavedText}" FontSize="11" Foreground="{StaticResource DotBlue}" />
                      </Border>
                      <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedText}" VerticalAlignment="Bottom" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedText}" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasPrompt, Converter={StaticResource BoolToVisibility}}">
                      <Run Text="{Binding PromptText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" />
                      <Run Text=" — " Foreground="{StaticResource MutedText}" />
                      <Run Text="{x:Static vm:FolderRowViewModel.PromptHint}" Foreground="{StaticResource MutedText}" />
                    </TextBlock>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap"
                               Margin="0,4,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <Border Margin="0,6,0,0" Padding="6,4" Background="#FF1E1E1E" CornerRadius="3"
                            Visibility="{Binding HasLastLines, Converter={StaticResource BoolToVisibility}}">
                      <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding LastLinesText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="#FFE6E6E6" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                      </ScrollViewer>
                    </Border>
                  </StackPanel>

                  <!-- Buttons -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource RowButton}" Content="Take over" Command="{Binding TakeOverCommand}"
                            Visibility="{Binding ShowTakeOver, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource RowButton}" Content="Restart" Command="{Binding RestartCommand}"
                            Visibility="{Binding ShowRestartButton, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource RowButton}" Content="Show" Command="{Binding ShowCommand}" />
                    <Button Style="{StaticResource SwitchButton}" Command="{Binding ToggleCommand}"
                            AutomationProperties.Name="ON/OFF" ToolTip="{Binding ToggleToolTip}" />
                    <Button Style="{StaticResource RowButton}" Content="…" MinWidth="30" Click="RowMenu_Click"
                            AutomationProperties.Name="More" ToolTip="More">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Restart" Command="{Binding RestartCommand}" />
                          <Separator />
                          <MenuItem Header="Open folder in Explorer" Command="{Binding OpenInExplorerCommand}" />
                          <MenuItem Header="Open in Windows Terminal" Command="{Binding OpenInTerminalCommand}" />
                          <MenuItem Header="View log" Command="{Binding ViewLogCommand}" />
                          <Separator />
                          <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
