<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Stand-in for claude.exe in the host integration tests (SPEC 17). Behaviour comes from
    fakeclaude.json in its working folder; see Program.cs. Never shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
